# ==============================================================================
# E*TRADE API Credentials Configuration
# ==============================================================================
# 1. Apply for an E*TRADE developer account at:
#    https://us.etrade.com/etx/ris/userprofile#developer
# 2. Obtain your Consumer Key and Consumer Secret for Sandbox and/or Production.
# 3. Rename this file to `.env` and fill in your keys.

ETRADE_CONSUMER_KEY=your_etrade_consumer_key_here
ETRADE_CONSUMER_SECRET=your_etrade_consumer_secret_here

# Optional: Specific account ID Key (if you have multiple brokerage accounts)
ETRADE_ACCOUNT_ID_KEY=

# Set to 'true' for Sandbox paper trading, 'false' for Live Production trading
ETRADE_SANDBOX=true

